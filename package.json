{
  "name": "@ai-galaxy/dsh-sound",
  "version": "0.5.0",
  "description": "DeepSeek Harness (0.2.x) plugin: per-event task-completion, user-stop, approval, question, plan-review, goal-blocked and failure sounds, each with its own sound and volume, plus a separate subagent channel (Web UI)",
  "icon": "icon.svg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iBobbyTS/dsh-sound.git"
  },
  "homepage": "https://github.com/iBobbyTS/dsh-sound#readme",
  "bugs": {
    "url": "https://github.com/iBobbyTS/dsh-sound/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "icon.svg",
    "screenshots.json",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs",
    "src"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "test": "node scripts/check.mjs test",
    "check": "node scripts/check.mjs all",
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json",
    "build:runtime": "node scripts/build-runtime.mjs",
    "check:dist": "node scripts/check.mjs dist"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "notification",
    "sound",
    "ringtone",
    "subagent",
    "tts",
    "voice"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "~3.19.0",
    "react": "^18.3.1"
  },
  "packageManager": "pnpm@10.28.2",
  "devDependencies": {
    "typescript": "5.9.3",
    "tsdown": "0.22.14",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "react": "18.3.1",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/schemastery": "3.19.0"
  }
}
